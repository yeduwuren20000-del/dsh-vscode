# Normalize line endings: LF in the repo, native on checkout.
* text=auto eol=lf

*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.d.ts  text eol=lf

# Keep binary assets binary
*.png   binary
*.jpg   binary
*.ico   binary
*.woff  binary
*.woff2 binary
